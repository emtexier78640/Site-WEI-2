# ─────────────────────────────────────────────────────────────
# Copie ce fichier en ".env.local" et remplis les vraies valeurs.
# NE JAMAIS committer .env / .env.local dans git !
# En prod, ces variables se définissent dans Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Chaîne de connexion Postgres (Vercel Postgres / Neon, avec sslmode=require)
DATABASE_URL=

# Secret de signature des sessions JWT (32+ caractères). Génère-le avec :
#   openssl rand -hex 32
JWT_SECRET=

# Code d'invitation demandé à l'inscription (à communiquer aux participants)
WEI_INVITE_CODE=

# Compte BDE admin, créé/mis à jour par `npm run db:seed-admin`
ADMIN_USERNAME=bde
# Hash bcrypt du mot de passe admin (recommandé). Exemple pour le générer :
#   node -e "import('bcryptjs').then(b=>console.log(b.hashSync(process.argv[1],12)))" 'MonMotDePasse'
ADMIN_PASSWORD_HASH=
# Alternative : mot de passe en clair, haché automatiquement par le script de seed
# (ne l'utilise qu'en local, jamais dans les variables Vercel).
# ADMIN_PASSWORD=

# Token Vercel Blob (Storage → Blob → .env.local / `vercel env pull`)
BLOB_READ_WRITE_TOKEN=
