# ─────────────────────────────────────────────────────────────
# Copie ce fichier en ".env" et remplis les vraies valeurs.
# NE JAMAIS committer le fichier .env dans git !
# ─────────────────────────────────────────────────────────────

# Mots de passe pour le compte BDE admin (séparés par des virgules)
# Exemple : BDE_PASSWORDS=monsupermotdepasse,autremdp
BDE_PASSWORDS=

# Token Notion (API officielle) — récupérable sur https://www.notion.so/my-integrations
NOTION_TOKEN=

# ID de la base de données Notion pour les commentaires
NOTION_COMMENTS_DB_ID=

# ID de la base de données Notion pour les validations
NOTION_VALIDATIONS_DB_ID=
